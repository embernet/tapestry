# Copy to .env. These are the DEV values; prod's .env uses
#   COMPOSE_PROJECT_NAME=tapestry  TAPESTRY_PORT=8200
#   TAPESTRY_DATA_DIR=/data/apps/tapestry  PUBLIC_URL=https://<prod host>
COMPOSE_PROJECT_NAME=tapestry-dev
TAPESTRY_PORT=8205
TAPESTRY_DATA_DIR=./data
# Run as the host user so the data dir stays yours (id -u / id -g).
APP_UID=1000
APP_GID=1000
# Where promote.sh keeps database snapshots (prod only).
TAPESTRY_BACKUP_DIR=/data/backups/tapestry

# Public base URL of this instance (builds the SSO redirect URI <PUBLIC_URL>/auth/callback).
PUBLIC_URL=
# Optional: a portal this deployment belongs to. With both set, the page shows
# "← <PORTAL_NAME>" linking to PORTAL_URL; leave empty to run standalone.
PORTAL_URL=
PORTAL_NAME=
# Set when behind a reverse proxy (Express "trust proxy"), e.g. TRUST_PROXY="loopback, uniquelocal".
# Quote values with spaces: promote.sh reads this file as shell.
TRUST_PROXY=

# Login (server/auth/README.md). Default: local accounts only.
# Add one with: scripts/user.sh add <username> "Display Name"
AUTH_LOCAL=on
AUTH_SSO=off
SSO_ISSUER=https://tig-sso.grlab.co.uk/realms/tig
SSO_CLIENT_ID=
# Confidential clients only: a file path, never the secret itself.
SSO_CLIENT_SECRET_FILE=
# Comma list of local usernames who are admins.
LOCAL_ADMIN_USERS=
SSO_ADMIN_GROUP=
SESSION_DAYS=7
